# ─────────────────────────────────────────────
# Google Cloud / Vertex AI
# ─────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Path to a GCP service account JSON key file.
# Leave blank when running on Cloud Run (uses Workload Identity / metadata server).
GOOGLE_APPLICATION_CREDENTIALS=

# ─────────────────────────────────────────────
# Model configuration
# ─────────────────────────────────────────────
# Gemini model ID to use across all agents. Swap to a different model here;
# no code changes required.  Defaults to gemini-2.0-flash if not set.
GEMINI_MODEL=gemini-2.0-flash

# ─────────────────────────────────────────────
# Orchestration
# ─────────────────────────────────────────────
# Maximum number of critique-triggered re-run cycles before the system
# either accepts the result or abstains (0 = no retries, just one pass).
MAX_CRITIQUE_RETRIES=2

# ─────────────────────────────────────────────
# Observability
# ─────────────────────────────────────────────
LOG_LEVEL=INFO
# Set to true to export OpenTelemetry spans to Google Cloud Trace.
# Requires GOOGLE_CLOUD_PROJECT and appropriate IAM permissions.
ENABLE_CLOUD_TRACE=false

# ─────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────
HOST=0.0.0.0
PORT=8080
# Comma-separated list of allowed CORS origins (for local dev).
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# ─────────────────────────────────────────────
# Web crawling
# ─────────────────────────────────────────────
# Seconds to wait between outbound HTTP requests to news sites.
CRAWL_RATE_LIMIT_SECONDS=1.0
# Maximum articles to fetch per crawl tool call.
CRAWL_MAX_ARTICLES=5

# ─────────────────────────────────────────────
# SEC EDGAR
# ─────────────────────────────────────────────
# Required by SEC: "CompanyName AdminEmail" format.
SEC_USER_AGENT=AgenticFinancialAnalysis admin@example.com
